# AgroLake 密钥配置模板（不含真实密钥，可提交 Git）
# 用法：复制本文件为 .env，填入自己的密钥。.env 已被 .gitignore 排除。
# 读取顺序：环境变量 > 本文件 > 代码内默认值。密钥不会写入数据库、日志或页面。

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=

# 选填：接口地址与模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 选填：调用参数（留空则用默认值）
# 超时秒数，默认 30，范围 1-300
# DEEPSEEK_TIMEOUT=30
# 单次回答的最大 token，默认 900，范围 16-8192
# DEEPSEEK_MAX_TOKENS=900
# 采样温度，默认 0.2，范围 0-2（事实问答建议保持低温）
# DEEPSEEK_TEMPERATURE=0.2
# 最多尝试次数，默认 2，硬上限 3；只有超时/限流/5xx 会重试
# DEEPSEEK_MAX_ATTEMPTS=2
